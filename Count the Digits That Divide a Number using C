#include <stdio.h>

int countDigits(int num) {
    int count = 0;
    int temp = num;
    
    // Loop through each digit mathematically
    while (temp > 0) {
        int digit = temp % 10;
        
        // Check if the original number is perfectly divisible by the isolated digit
        if (num % digit == 0) {
            count++;
        }
        
        // Remove the processed digit from temp
        temp /= 10;
    }
    
    return count;
}
